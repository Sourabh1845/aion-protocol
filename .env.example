# Copy to .env (git-ignored) or export these in your shell.
# Never commit real values.

# --- Hosted AION verification API (see README "hosted verification API") ---
# Required by the server. The AION CLI and local mandates work without it.
AION_API_KEY=

# Optional: point the CLI/scripts at your own server (default: Azure/Render demo)
AION_BASE_URL=https://aion-protocol.onrender.com

# Only for local development: accept the public dev key "aion-dev-key-local".
# Never set this on a real server.
# AION_ALLOW_DEV_KEY=1

# --- Local state (keys + sqlite store) ---
# Defaults to ~/.aion (keys in ~/.aion/keys, store in ~/.aion/aion.db).
# Override only if you want a different location; keep it out of site-packages
# so `pip install --upgrade` cannot wipe your signing identity.
# AION_HOME=C:\aion-state
# AION_KEY_DIR=
# AION_DB_PATH=

# --- Postgres (only for the hosted API) ---
DATABASE_URL=

# --- Legacy Groq demo (aion_pkg/aion/aion_demo.py) ---
GROQ_API_KEY=
